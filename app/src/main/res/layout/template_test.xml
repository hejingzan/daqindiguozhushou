<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模板测试（可视化匹配）"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选一个模板 → 点截屏。会截一张游戏画面，并用红框标出机器人“认为”的目标位置。\n如果红框没框中盗匪图标，说明模板没截好，请回去重新采集。"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_test_tpl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_test_shoot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📷 截屏并测试"
            android:textSize="15sp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/img_test"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#000000"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="（尚未测试）"
            android:textSize="13sp"
            android:textColor="#FFE082"
            android:background="#102027"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_test_back"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="← 返回"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
