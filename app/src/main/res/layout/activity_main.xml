<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：就绪"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#263238"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一、先开启权限"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btn_acc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⛨ 开启无障碍权限"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="二、采集模板（游戏里把对应按钮露出来，再点下面的按钮，悬浮「截图」会浮出来，进游戏点它即可裁图）"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginTop="6dp">

            <Button android:id="@+id/btn_capture_bandit" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="44dp" android:text="① 盗匪图标" android:textSize="13sp" />
            <Button android:id="@+id/btn_capture_attack" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="44dp" android:text="② 讨伐" android:textSize="13sp" />
            <Button android:id="@+id/btn_capture_march" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="44dp" android:text="③ 确认出征" android:textSize="13sp" />
            <Button android:id="@+id/btn_capture_confirm" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="44dp" android:text="④ 确定领奖" android:textSize="13sp" />
            <Button android:id="@+id/btn_capture_close" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="44dp" android:text="⑤ 关闭叉号" android:textSize="13sp" />
            <Button android:id="@+id/btn_capture_home" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="44dp" android:text="⑥ 主城/地图" android:textSize="13sp" />
        </GridLayout>

        <TextView
            android:id="@+id/text_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#FFB74D"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="★ 备用通路：从相册导入（不需要录屏和悬浮窗）"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 在游戏里用系统截图键截屏并存到相册　② 选好下面的模板　③ 点「从相册导入」，在图上框选保存"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spinner_tpl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btn_import_gallery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📥 从相册导入模板"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1565C0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="四、参数设置"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="最低等级" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_min_level" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:text="1" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="最高等级" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_max_level" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:text="99" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="体力下限" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_stamina" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:text="20" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="最大轮次" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_max_cycle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:text="30" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="匹配阈值(0.6-0.95)" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_threshold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="0.8" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="基础延时(ms)" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_delay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:text="1200" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="休眠(秒)" android:textSize="13sp" android:gravity="center_vertical" />
            <EditText android:id="@+id/edit_sleep" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:text="300" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/check_ocr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用 OCR 等级/体力识别（需联网首次下载模型，不勾也能纯模板匹配）"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶ 开始挂机"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2E7D32" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ 学习研究用途，游戏官方禁止脚本，真机使用有封号风险，勿用于正式账号。"
            android:textSize="11sp"
            android:textColor="#C62828"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="五、运行诊断（出问题时截图这一块发我）"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btn_diag_clear"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="清空日志"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/text_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(暂无日志)"
            android:textSize="11sp"
            android:textColor="#B9F6CA"
            android:background="#102027"
            android:padding="8dp"
            android:layout_marginTop="6dp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>
