<?xml version="1.0" encoding="utf-8"?>
<!-- 游戏内悬浮控制台：开始 / 停止、校准、队伍数选择、退出 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E6111A20"
    android:padding="6dp"
    android:minWidth="132dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="大秦助手 · 可拖动"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="就绪"
        android:textColor="#8FE388"
        android:textSize="10sp"
        android:maxWidth="150dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:text="▶ 开始"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:backgroundTint="#2E7D32" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="3dp">

        <Button
            android:id="@+id/btn_calib"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:text="校准"
            android:textSize="12sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#1565C0" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:text="退出"
            android:textSize="12sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#616161" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/tv_troop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="自选队伍：未设"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingStart="2dp" />

        <Button
            android:id="@+id/btn_minus"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:text="－"
            android:textSize="13sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_plus"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:text="＋"
            android:textSize="13sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_troop_toggle"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:text="全选：开"
        android:textSize="11sp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button
            android:id="@+id/btn_search"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:text="周边 1000 里"
            android:textSize="11sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#455A64" />

        <Button
            android:id="@+id/btn_level"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:layout_marginStart="3dp"
            android:text="等级：不限"
            android:textSize="11sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#455A64" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button
            android:id="@+id/btn_mode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:text="讨伐"
            android:textSize="11sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#6A1B9A" />

        <Button
            android:id="@+id/btn_act"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:layout_marginStart="3dp"
            android:text="时段：全天"
            android:textSize="11sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#455A64" />
    </LinearLayout>
</LinearLayout>
