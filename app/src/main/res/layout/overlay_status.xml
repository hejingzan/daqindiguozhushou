<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮控制窗布局。
  注意：整棵布局必须保持 wrap_content，不能出现 match_parent 子项。
  在 wrap_content 父容器下，match_parent 子项会被测成整屏宽度，
  横向铺满一条区域挡住触摸（配合触摸模态窗口会导致全屏点不动）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/overlay_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="就绪"
        android:textColor="#8FE388"
        android:textSize="11sp"
        android:maxWidth="150dp"
        android:maxLines="3" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btn_overlay_stop"
            android:layout_width="62dp"
            android:layout_height="34dp"
            android:text="⏸ 停止"
            android:textSize="12sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#C62828" />

        <Button
            android:id="@+id/btn_overlay_shoot"
            android:layout_width="72dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:text="📷 截图"
            android:textSize="12sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#1565C0"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
